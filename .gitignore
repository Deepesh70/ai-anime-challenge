*.jpeg

# Keep visual assets directory structure if needed, but ignore raw large outputs
!comparisons/.gitkeep

# Pretrained Model Weights (>100MB / binary weights)
# Weights are automatically retrieved or placed into model_zoo/
model_zoo/*.pth
model_zoo/*.pt
model_zoo/*.bin
model_zoo/*.onnx
model_zoo/*.safetensors
!model_zoo/.gitkeep

