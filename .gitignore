.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Obsidian workspace cache (keeps notes, ignores local UI state)
vault/.obsidian/cache
vault/.obsidian/workspace*
